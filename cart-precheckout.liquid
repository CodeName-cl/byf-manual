{%- assign showBillingMenu = false -%}
{%- if isBillingEnabled and isVoucherEnabled != true -%}
{%- assign showBillingMenu = true -%}
{%- endif -%}


<div style="clear:both"></div>
<!-- Preceheckout -->
<div class="pre-check">
  <div class="factura">

    {%- if isBillingEnabled and isVoucherEnabled -%}
    <div class="cart-document-type">
      <h5>Tipo de documento</h5>
      <span class="cart__subtotal">
        <input required="" id="btn-boleta" class="styled-checkbox required btn-boleta document-type-selector"
          type="radio" name="attributes[shoppingcart-tags]" value="boleta" checked="checked">
        <label for="btn-boleta" class="cart-boleta">Boleta</label>
        <input required="" id="btn-factura" class="styled-checkbox required btn-factura document-type-selector"
          type="radio" name="attributes[shoppingcart-tags]" value="factura">
        <label for="btn-factura" class="cart-factura">Factura</label>
      </span>
    </div>
    {%- endif -%}

    <div class="billing-menu">
      <h5>{{ billingDataTitle }}</h5>
      <p class="cart-attribute__field">
        <label class="rut-field" for="rut">{{ rutLabel }} <small>{{ rutLabelSmall }}</small></label>
        <input id="rut" type="text" name="attributes[RUT]" placeholder="{{ rutPlaceHolder }}" value="">
      </p>
      <p class="cart-attribute__field cart-attribute__field-razon">
        <label class="razon-field" for="razon">{{ razonLabel }} <small>{{ razonLabelSmall }}</small></label>
        <input id="razon" type="text" name="attributes[razon]" placeholder="{{ razonPlaceHolder }}" value="">
      </p>
      <p class="cart-attribute__field cart-attribute__field-razon">
        <label class="razon-field" for="razon">{{ giroLabel }} <small>{{ giroLabelSmall }}</small></label>
        <input id="razon" type="text" name="attributes[giro]" placeholder="{{ giroPlaceHolder }}" value="">
      </p>
    </div>
  </div>

  <div class="comunas">
    <h5>Dirección de envío</h5>
    <p class="alert">
      Debes seleccionar tu comuna para continuar
    </p>
    <div class="town-selector-modal">
      <div class="town-selector-modal-content">
        <p class="cart-attribute__field">
          <label for="city">Región</label>
          <select id="select-city" name="[shipping_address][city]">
            <option value="">Selecciona tu Región</option>
            <option value="AP">Arica y Parinacota</option>
            <option value="TA">Tarapacá</option>
            <option value="AN">Antofagasta</option>
            <option value="AT">Atacama</option>
            <option value="CO">Coquimbo</option>
            <option value="VS">Valparaí&shy;so</option>
            <option value="RM">Región Metropolitana</option>
            <option value="LI">O'Higgins</option>
            <option value="ML">Maule</option>
            <option value="NB">Ñuble</option>
            <option value="BI">Biobio</option>
            <option value="AR">Araucanía</option>
            <option value="LR">Los Rí&shy;os</option>
            <option value="LL">Los Lagos</option>
            <option value="AI">Aysén</option>
            <option value="MA">Magallanes</option>
          </select>
        </p>
        <p class="cart-attribute__field">
          <label for="town">Comuna</label>
          <select id="select-town" name="[shipping_address][province]">
            <option value="">Selecciona tu Comuna</option>
          </select>
        </p>
      </div>
    </div>
  </div>

  <div class="shipping_costs">
    <p>Costos de despacho:</p>
    <p class="shipping_costs_wrapper"></p>
  </div>

  <div class="tos">
    <p class="cart-attribute__field">
      <label for="city"><input type="checkbox" required> Estoy de acuerdo con los Términos y condiciones <a
          href="/pages/politicas-de-envio" target="_blank">Mostrar Términos</a></label>
    </p>
  </div>

