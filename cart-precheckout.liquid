<!-- Precheckout -->


<style>
  .cart__subtotal-title {
    display: block;
    width: 100%;
    margin-top: 5px;
  }

  .cart__subtotal {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .billing-menu {
    display: {%- if showBillingMenu -%}block {%- else -%}none {%- endif -%};
  }

  .rut-field,
  .razon-field {
    color: #3d4246;
    font-size: 16px;
  }

  .razon-field {
    padding-right: 230px;
  }

  .cart-boleta {
    margin-right: 8.7px;
  }

  .cart-document-type {}

  .doc-type {
    float: left;
    width: calc(100% - 154px);
  }

  .comunas {
    margin-top: 10px;
  }

  .pre-check {
    padding: 20px;
    background: #eee;
    /* float: right;
        width: 25%; */
    margin-bottom: 50px;
  }

  @media only screen and (max-width: 1000px) {
    .pre-check {
      float: none;
      width: 100%;
      order: 2;
    }

    .cart__form {
      display: flex;
      flex-direction: column;
    }
  }

  .cart-attribute__field {
    margin-top: 5px;
  }

  .cart-attribute__field select,
  .cart-attribute__field input[type=text] {
    width: 100%;
    padding: 5px;
    border: #ccc solid 1px;
    border-radius: 0px;
  }

  .alert {
    display: none;
  }

  .invalido {
    border: red solid 1px !important;
  }

  .invalido:focus-visible {
    outline: none;
  }

  .submit {
    margin-top: 10px;
  }

  .add_to_cart_precheckout {
    width: 100%;
    padding: 20px;
    background: black;
    color: white;
  }

  .add_to_cart_precheckout .icon {
    width: 1em;
    height: 1em;
    margin-right: 5px !important;
  }

  .tos {
    margin-top: 10px;
  }

  @media only screen and (max-width: 749px) {
    .cart-boleta {
      margin-right: 35.7px;
    }

    .rut-field,
    .razon-field {
      text-align: left;
    }

    #rut,
    #razon {
      width: 100%;
    }
  }
</style>
<script type="text/javascript">
  setTimeout(function () {
    var actions = {
      "factura": function () {
        $(".billing-menu").css("display", "block");
      },
      "boleta": function () {
        $(".billing-menu").css("display", "none");
      }
    }
    $(".document-type-selector").on("change", function () {
      actions[$(this).val()]();
    });
  }, 500);

  const dom_rut = document.getElementById("rut");

  dom_rut.addEventListener(
    'input', function () {
      var valor = rut.value.replace('.', '');
      valor = valor.replace('-', '');
      cuerpo = valor.slice(0, -1);
      dv = valor.slice(-1).toUpperCase();
      rut.value = cuerpo + '-' + dv

      if (cuerpo.length < 7) {
        dom_rut.classList.add("invalido");
        dom_rut.classList.remove("valido");
        rut.setCustomValidity("RUT Incompleto"); return false;
      } else {
        dom_rut.classList.add("valido");
        dom_rut.classList.remove("invalido");
      }

      suma = 0;
      multiplo = 2;

      for (i = 1; i <= cuerpo.length; i++) {
        index = multiplo * valor.charAt(cuerpo.length - i);
        suma = suma + index;
        if (multiplo < 7) { multiplo = multiplo + 1; } else { multiplo = 2; }
      }

      dvEsperado = 11 - (suma % 11);

      dv = (dv == 'K') ? 10 : dv;
      dv = (dv == 0) ? 11 : dv;

      // Validar que el Cuerpo coincide con su Dígito Verificador
      if (dvEsperado != dv) {
        dom_rut.classList.add("invalido");
        dom_rut.classList.remove("valido");
        rut.setCustomValidity("RUT Inválido"); return false;
      } else {
        dom_rut.classList.add("valido");
        dom_rut.classList.remove("invalido");
      }
      // Si todo sale bien, eliminar errores (decretar que es válido)
      rut.setCustomValidity('');
    });

</script>



