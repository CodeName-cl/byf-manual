<!-- TODO: paste where the block will be rendered -->
{%- for block in section.blocks -%}
  {% if block.type == 'precheckout' %}
    {% render 'cart-precheckout',
      isVoucherEnabled: block.settings.isVoucherEnabled,
      isBillingEnabled: block.settings.isBillingEnabled,
      isShippingEnabled: block.settings.isShippingEnabled,
      isShippingCostEnabled: block.settings.isShippingCostEnabled,
      isTosEnabled: block.settings.isTosEnabled,
      billingDataTitle: block.settings.billingDataTitle,
      ticketDataTitle: block.settings.ticketDataTitle,
      backgroundColor: block.settings.backgroundColor,
      labelColor: block.settings.labelColor,
      rutLabel: block.settings.rutLabel,
      rutPlaceHolder: block.settings.rutPlaceHolder,
      razonLabel: block.settings.razonLabel,
      razonPlaceHolder: block.settings.razonPlaceHolder,
      giroLabel: block.settings.giroLabel,
      giroPlaceHolder: block.settings.giroPlaceHolder,
      rutLabelSmall: block.settings.rutLabelSmall,
      razonLabelSmall: block.settings.razonLabelSmall,
      giroLabelSmall: block.settings.giroLabelSmall,
      inputTextColor: block.settings.inputTextColor,
      inputPlaceHolderTextColor: block.settings.inputPlaceHolderTextColor,
      inputPadding: block.settings.inputPadding,
      labelMarginTop: block.settings.labelMarginTop,
      labelMarginBottom: block.settings.labelMarginBottom,
      inputMargin: block.settings.inputMargin,
      radioButtonHeight: block.settings.radioButtonHeight,
      radioButtonWidth: block.settings.radioButtonWidth,
      inputBorderRadius: block.settings.inputBorderRadius
    %}
  {% endif %}
{% endfor %}
<!-- /end -->
